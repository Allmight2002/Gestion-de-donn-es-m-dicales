{
  "nodeModulesDir": "auto",
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14",
    "@supabase/supabase-js": "jsr:@supabase/supabase-js@2.45.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/package/xlsx.mjs"
  },
  "fmt": {
    "include": ["supabase/functions/**/*.ts"],
    "lineWidth": 120,
    "singleQuote": true
  },
  "lint": {
    "include": ["supabase/functions/**/*.ts"]
  },
  "tasks": {
    "edge:fmt": "deno fmt --check",
    "edge:lint": "deno lint",
    "edge:check": "deno check --frozen --allow-import=cdn.sheetjs.com,jsr.io,registry.npmjs.org supabase/functions",
    "edge:test": "deno test --frozen --allow-import=cdn.sheetjs.com,jsr.io,registry.npmjs.org supabase/functions"
  }
}
