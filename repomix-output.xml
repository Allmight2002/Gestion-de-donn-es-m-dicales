            <EditEncounter />
          </ProtectedRoute>
        }
      />
      <Route
        path="/bases/:id/patients/:patientId/images/new"
        element={
          <ProtectedRoute area="member">
            <AddImage />
          </ProtectedRoute>
        }
      />
      <Route
        path="/admin"
        element={
          <ProtectedRoute area="admin">
            <TemplatesAdmin />
          </ProtectedRoute>
        }
      />
      <Route
        path="/admin/roles"
        element={
          <ProtectedRoute area="admin">
            <RoleAdmin />
          </ProtectedRoute>
        }
      />
      <Route path="*" element={<NotFound />} />
    </Routes>
  );
}
