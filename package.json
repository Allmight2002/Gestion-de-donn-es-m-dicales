{
  "name": "registre-clinique",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10 <12"
  },
  "description": "Registre clinique oriente recherche - separation identite/analytique, RLS testee (MVP).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run --project db",
    "test:web": "vitest run --project web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:stop": "supabase stop",
    "supabase:storage": "node scripts/apply-storage.mjs",
    "storage:backup": "node scripts/storage-object-backup.mjs backup",
    "storage:backup:verify": "node scripts/storage-object-backup.mjs verify",
    "storage:restore": "node scripts/storage-object-backup.mjs restore",
    "backup:coordinated": "node scripts/coordinated-backup.mjs backup",
    "backup:coordinated:verify": "node scripts/coordinated-backup.mjs verify",
    "backup:coordinated:extract": "node scripts/coordinated-backup.mjs extract",
    "recovery:evidence:verify": "node scripts/validate-recovery-evidence.mjs",
    "governance:evidence:verify": "node scripts/validate-governance-evidence.mjs",
    "github:controls:verify": "node scripts/verify-github-controls.mjs",
    "db:function-acl:verify": "node scripts/verify-function-privileges.mjs",
    "ops:monitor": "node scripts/operations-monitor.mjs",
    "create-account": "node scripts/create-account.mjs",
    "db:verify": "node scripts/verify-migrations.mjs",
    "schema": "node scripts/dump-schema.mjs",
    "manifest": "node scripts/deploy-manifest.mjs",
    "env:check": "node scripts/check-inspection-env.mjs",
    "env:check:cloud": "node scripts/check-inspection-env.mjs --cloud",
    "inspection:activate": "node scripts/activate-strict-inspection.mjs",
    "release:env": "node scripts/release-env-check.mjs",
    "release:target": "node scripts/check-supabase-target.mjs",
    "release:edge:check": "node scripts/verify-edge-functions.mjs",
    "edge:fmt": "deno task edge:fmt",
    "edge:lint": "deno task edge:lint",
    "edge:check": "deno task edge:check",
    "edge:test": "deno task edge:test",
    "release:drift": "node scripts/release-drift.mjs",
    "e2e:staging": "node scripts/e2e-staging.mjs",
    "e2e:browser": "playwright test",
    "e2e:browser:critical": "playwright test e2e/auth-roles.spec.ts e2e/export-journey.spec.ts e2e/patient-journey.spec.ts --grep @critical"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@supabase/storage-js": "2.108.2",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.0.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jsdom": "^25.0.1",
    "pg": "^8.21.0",
    "supabase": "2.109.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.62.1",
    "vite": "8.1.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
