# =============================================================================
#  Variables d'environnement — DEPLOIEMENT (projet Supabase cloud)
#  Copiez en .env.production (gitignore) et remplissez avec les valeurs du projet.
#  RAPPEL : seules les variables VITE_ sont injectees dans le bundle frontend.
#  SUPABASE_SERVICE_ROLE_KEY et SUPABASE_DB_URL restent COTE SERVEUR (scripts), jamais
#  dans le frontend.
# =============================================================================

# ---- Frontend (exposable au navigateur) -------------------------------------
#  Tableau de bord Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://VOTRE-REF.supabase.co
VITE_SUPABASE_ANON_KEY=remplacer_par_la_cle_anon_du_projet
#  Lectures de fichiers AUDITEES via la fonction Edge `signed-read` (audit §9.2). Mettre 'true'
#  En production, le build refuse le repli client non audite.
VITE_USE_SIGNED_READ=true
#  Donnees reelles uniquement : exige `inspect-upload` + ClamAV avant toute lecture.
#  Doit valoir 'false' quand INSPECTION_MODE=paused, 'true' quand INSPECTION_MODE=strict.
VITE_REQUIRE_SERVER_INSPECTION=
# Le cache clinique hors-ligne reste interdit dans les releases normales.
VITE_OFFLINE_MODE=disabled
VITE_OFFLINE_ADMIN_ACK=false
# La saisie hors-ligne intake-only reste également désactivée hors preview explicitement autorisé.
VITE_OFFLINE_INTAKE=disabled

# ---- Scripts serveur UNIQUEMENT (creation de comptes, application de storage.sql) ----
SUPABASE_URL=https://VOTRE-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=remplacer_par_la_cle_service_role
#  Project Settings -> Database -> Connection string (URI). Garder le mot de passe hors VCS.
SUPABASE_DB_URL=postgresql://postgres:MDP@db.VOTRE-REF.supabase.co:5432/postgres
# Cle AES-256 (32 octets en base64) distincte par environnement. Le workflow l'utilise pour
# chiffrer et authentifier la sauvegarde DB + Storage AVANT toute ecriture de release.
STORAGE_BACKUP_ENCRYPTION_KEY=remplacer_par_une_cle_base64_de_32_octets

# ---- Edge Functions / antivirus serveur -------------------------------------
SUPABASE_ANON_KEY=remplacer_par_la_cle_anon_du_projet
# Parcours d'inspection antivirus (decision du 12 aout 2026) :
#   paused = aucun scanner requis. Les fichiers ne sont PAS analyses et redeviennent
#            lisibles sur le seul controle navigateur. Donnees FICTIVES uniquement.
#   strict = scanner ClamAV joignable exige. SEUL mode admissible avec des donnees reelles.
# Non renseigne => 'strict' : l'antivirus ne se desactive jamais par oubli.
INSPECTION_MODE=paused
# URL publique/privee du pont HTTP ClamAV qui expose POST /scan (INSPECTION_MODE=strict).
CLAMAV_SCAN_URL=https://scanner.example.org/scan
CLAMAV_SCAN_TOKEN=remplacer_par_un_secret_aleatoire_de_32_caracteres_minimum
CLAMAV_SCAN_TIMEOUT_MS=30000
MAX_SCAN_BYTES=26214400
# A poser en secret Edge quand VITE_REQUIRE_SERVER_INSPECTION=true.
REQUIRE_SERVER_INSPECTION=
# Garde-fou release : mettre 'true' apres avoir active la politique DB :
# update public.app_security_setting set value='true', updated_at=now() where key='require_server_inspection';
DB_REQUIRE_SERVER_INSPECTION=
# Limite Edge <= limite scanner ; doit correspondre aux limites de supabase/storage.sql.
MAX_INSPECT_UPLOAD_BYTES=20971520
INSPECTION_SCANNING_STALE_MS=900000
MAX_INSPECTION_ATTEMPTS=5
INSPECTION_RETRY_COOLDOWN_MS=60000
QUARANTINE_BUCKET=quarantined-uploads
