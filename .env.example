# =============================================================================
#  Variables d'environnement — registre-clinique
# =============================================================================
#  RAPPEL DE SECURITE (cahier technique §12) :
#  - Seules les variables prefixees VITE_ sont injectees dans le bundle frontend.
#  - La cle service_role (SUPABASE_SERVICE_ROLE_KEY) NE DOIT JAMAIS etre prefixee
#    VITE_, ni etre lue par du code frontend. Elle reste cote serveur / scripts.
#  - Ce fichier .env.example ne contient AUCUN secret reel. Copiez-le en .env
#    (gitignore) et remplissez les valeurs.
#
#  NB: les tests de securite RLS (etape 2) n'utilisent PAS ces variables : ils
#  demarrent un PostgreSQL embarque. `npm test` fonctionne sans aucune config.
# =============================================================================

# ---- Exposable au navigateur (frontend, etape 3+) -----------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=remplacer_par_la_cle_anon
# Lecture des fichiers via Edge signed-read. En demo locale, laissez vide.
VITE_USE_SIGNED_READ=
# Donnees reelles uniquement : exige l'appel Edge inspect-upload apres chaque upload.
VITE_REQUIRE_SERVER_INSPECTION=

# ---- Cote serveur UNIQUEMENT (jamais dans le frontend) ------------------------
SUPABASE_SERVICE_ROLE_KEY=remplacer_par_la_cle_service_role
# Chaine de connexion Postgres (scripts : apply-storage, env:check:cloud). Laissez VIDE en
# local (repli automatique sur le Postgres du CLI Supabase, 127.0.0.1:54322). Forme :
#   postgresql://<utilisateur>:<mot-de-passe>@<hote>:<port>/postgres
# NB : pas de valeur user:password@ ici — le controle de securite de Repomix exclurait
# ce fichier des paquets d'audit (v18 §6.1).
SUPABASE_DB_URL=
# Edge Functions / scanner antivirus. Pour lancer le scanner local :
#   docker compose -f docker-compose.clamav.yml up -d --build
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=remplacer_par_la_cle_anon
CLAMAV_SCAN_URL=http://127.0.0.1:8088/scan
CLAMAV_SCAN_TOKEN=change-me
REQUIRE_SERVER_INSPECTION=
MAX_INSPECTION_ATTEMPTS=5
INSPECTION_RETRY_COOLDOWN_MS=60000
QUARANTINE_BUCKET=quarantined-uploads
